# Required: MongoDB connection string (used in src/lib/db.ts)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cybsync?retryWrites=true&w=majority
# or for a local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/cybsync

# Required: secret key for signing login tokens (used in src/lib/auth.ts)
JWT_SECRET=replace-with-a-long-random-string

# Optional: how long a login stays valid (default is "1d")
TOKEN_EXPIRY=1d

# Required for student login: Google OAuth client ID (Web application) from
# Google Cloud Console. Not a secret. Set it before building, because it's
# built into the login page. See docs/STUDENT_LOGIN_BACKEND_INTEGRATION.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Required for student login: only Google accounts from this school email
# domain can sign in.
ALLOWED_EMAIL_DOMAIN=myschool.edu.ph
